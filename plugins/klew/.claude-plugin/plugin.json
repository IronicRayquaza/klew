{
  "name": "klew",
  "displayName": "Klew",
  "version": "0.1.0",
  "description": "Self-improving code context: an MCP server that walks a code graph in HydraDB to give Claude the files that matter for a task, and learns from every change you make.",
  "author": { "name": "Klew contributors", "url": "https://github.com/IronicRayquaza/klew" },
  "homepage": "https://github.com/IronicRayquaza/klew",
  "repository": "https://github.com/IronicRayquaza/klew",
  "license": "MIT",
  "keywords": ["mcp", "context", "code-graph", "hydradb", "rag"],
  "mcpServers": {
    "klew": {
      "command": "uvx",
      "args": ["--from", "klew==0.1.0", "klew", "mcp"],
      "env": { "KLEW_REPO_ROOT": "${CLAUDE_PROJECT_DIR}" }
    }
  }
}
