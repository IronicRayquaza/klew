# Klew hosted demo: HydraDB + Klew API + site in ONE container (fits free tiers such as Render or
# Hugging Face Spaces). The httpx and flask graphs are indexed and warm-started at build time, so the
# demo starts pre-trained. Visitors share the demo graph; it resets to this state on every restart.
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM ghcr.io/hydra-db/hydradb:latest
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV VIRTUAL_ENV=/opt/klew/venv PATH=/opt/klew/venv/bin:$PATH TIKTOKEN_CACHE_DIR=/opt/klew/tiktoken
WORKDIR /opt/klew/app
COPY pyproject.toml README.md LICENSE ./
COPY klew/ klew/
RUN python3 -m venv $VIRTUAL_ENV && pip install --no-cache-dir . \
    && python -c "from klew.adapters.tokens import count_tokens; count_tokens('warm up')"
RUN git clone -q https://github.com/encode/httpx.git /repos/httpx \
 && git clone -q https://github.com/pallets/flask.git /repos/flask
COPY deploy/demo-env.sh deploy/demo-build.sh /opt/klew/
RUN chmod +x /opt/klew/*.sh && /opt/klew/demo-build.sh \
 && chmod -R a+rwX /data /repos /opt/klew
# Results and the site come last, so changing them doesn't re-run the indexing step above.
COPY eval/results/ eval/results/
COPY --from=web /web/dist web/dist
COPY deploy/demo-start.sh /opt/klew/demo-start.sh
RUN chmod +x /opt/klew/demo-start.sh
ENV KLEW_WEB_DIR=/opt/klew/app/web/dist KLEW_RESULTS_DIR=/opt/klew/app/eval/results KLEW_RATE_PER_MIN=30 PORT=7860 KLEW_DEMO=1
EXPOSE 7860
ENTRYPOINT ["/opt/klew/demo-start.sh"]
